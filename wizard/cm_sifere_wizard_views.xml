<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cm_sifere_wizard_form" model="ir.ui.view">
        <field name="name">cm.sifere.wizard.form</field>
        <field name="model">cm.sifere.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar SIFERE">
                <!-- Estado draft: parámetros -->
                <group invisible="state != 'draft'">
                    <group string="Período">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Tipo">
                        <field name="export_type" widget="radio"/>
                    </group>
                </group>

                <!-- Estado done: archivo generado -->
                <div invisible="state != 'done'">
                    <group string="Archivo Generado">
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                        <field name="records_count"/>
                    </group>
                </div>

                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_generate"
                            string="Generar SIFERE"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_download"
                            string="Descargar ZIP"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cm_sifere_wizard" model="ir.actions.act_window">
        <field name="name">Exportar SIFERE</field>
        <field name="res_model">cm.sifere.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
