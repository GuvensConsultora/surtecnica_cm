<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cm_liquidation_wizard_form" model="ir.ui.view">
        <field name="name">cm.liquidation.wizard.form</field>
        <field name="model">cm.liquidation.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Liquidación CM">
                <group>
                    <group string="Período">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Coeficientes">
                        <field name="fiscal_year"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate"
                            string="Generar Liquidación"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cm_liquidation_wizard" model="ir.actions.act_window">
        <field name="name">Generar Liquidación CM</field>
        <field name="res_model">cm.liquidation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
