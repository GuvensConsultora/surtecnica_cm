<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cm_jurisdiction_list" model="ir.ui.view">
        <field name="name">cm.jurisdiction.list</field>
        <field name="model">cm.jurisdiction</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="state_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cm_jurisdiction_form" model="ir.ui.view">
        <field name="name">cm.jurisdiction.form</field>
        <field name="model">cm.jurisdiction</field>
        <field name="arch" type="xml">
            <form string="Jurisdicción CM">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cm_jurisdiction_search" model="ir.ui.view">
        <field name="name">cm.jurisdiction.search</field>
        <field name="model">cm.jurisdiction</field>
        <field name="arch" type="xml">
            <search string="Jurisdicciones CM">
                <field name="code"/>
                <field name="name"/>
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_cm_jurisdiction" model="ir.actions.act_window">
        <field name="name">Jurisdicciones CM</field>
        <field name="res_model">cm.jurisdiction</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
