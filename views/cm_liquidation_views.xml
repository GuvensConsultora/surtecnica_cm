<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Liquidacion - Kanban (Fase 5) -->
    <record id="cm_liquidation_kanban" model="ir.ui.view">
        <field name="name">cm.liquidation.kanban</field>
        <field name="model">cm.liquidation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <field name="period" class="fw-bold fs-5"/>
                        <div class="text-muted">
                            Ejercicio: <field name="fiscal_year"/>
                        </div>
                        <hr class="mt-1 mb-1"/>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Impuesto</span>
                            <field name="total_impuesto" widget="monetary"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Deducciones</span>
                            <field name="total_deducciones" widget="monetary"/>
                        </div>
                        <div class="d-flex justify-content-between fw-bold mt-1">
                            <span>Saldo</span>
                            <field name="total_saldo" widget="monetary"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Liquidacion - List -->
    <record id="cm_liquidation_list" model="ir.ui.view">
        <field name="name">cm.liquidation.list</field>
        <field name="model">cm.liquidation</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'calculated'"
                  decoration-success="state == 'confirmed'">
                <field name="period"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="fiscal_year"/>
                <field name="total_base_gravada" sum="Total"/>
                <field name="total_impuesto" sum="Total"/>
                <field name="total_deducciones" sum="Total"/>
                <field name="total_saldo" sum="Total" decoration-bf="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'calculated'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- Liquidacion - Form -->
    <record id="cm_liquidation_form" model="ir.ui.view">
        <field name="name">cm.liquidation.form</field>
        <field name="model">cm.liquidation</field>
        <field name="arch" type="xml">
            <form string="Liquidacion CM">
                <header>
                    <button name="action_confirm" string="Confirmar"
                            type="object" class="btn-primary"
                            invisible="state != 'calculated'"
                            groups="surtecnica_cm.group_cm_manager"/>
                    <button name="action_draft" string="Volver a Borrador"
                            type="object"
                            invisible="state != 'calculated'"
                            groups="surtecnica_cm.group_cm_manager"/>
                    <button name="action_recalculate_deductions"
                            string="Recalcular Deducciones"
                            type="object" class="btn-secondary"
                            invisible="state != 'calculated'"
                            groups="surtecnica_cm.group_cm_manager"/>
                    <!-- Botones de exportacion (Fase 3) -->
                    <button name="action_export_cm03" string="Exportar CM03"
                            type="object" class="btn-secondary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_export_sircar" string="Exportar SIRCAR"
                            type="object" class="btn-secondary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_export_sifere" string="Exportar SIFERE"
                            type="object" class="btn-secondary"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="fiscal_year"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lineas por Jurisdiccion" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="jurisdiction_id"/>
                                    <field name="activity_id"/>
                                    <field name="coefficient"/>
                                    <field name="base_gravada"/>
                                    <field name="base_no_gravada" optional="hide"/>
                                    <field name="base_exenta" optional="hide"/>
                                    <field name="base_distribuida"/>
                                    <field name="alicuota"/>
                                    <field name="impuesto_determinado" sum="Total"/>
                                    <field name="retenciones_sufridas" sum="Total"/>
                                    <field name="percepciones_sufridas" sum="Total"/>
                                    <field name="recaudaciones_bancarias" optional="show" sum="Total"/>
                                    <field name="saldo_anterior" optional="show"/>
                                    <field name="total_deducciones" sum="Total"/>
                                    <field name="saldo" sum="Total" decoration-bf="1"
                                           decoration-danger="saldo &gt; 0"
                                           decoration-success="saldo &lt;= 0"/>
                                    <button name="action_open_form" type="object"
                                            icon="fa-external-link" title="Ver detalle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Totales">
                        <group>
                            <field name="total_base_gravada"/>
                            <field name="total_impuesto"/>
                        </group>
                        <group>
                            <field name="total_deducciones"/>
                            <field name="total_saldo" decoration-bf="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Linea de liquidacion - Form con smart buttons (Fase 2) -->
    <record id="cm_liquidation_line_form" model="ir.ui.view">
        <field name="name">cm.liquidation.line.form</field>
        <field name="model">cm.liquidation.line</field>
        <field name="arch" type="xml">
            <form string="Detalle Jurisdiccion">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_percepciones" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="percepciones_count == 0">
                            <field name="percepciones_count" string="Percepciones"
                                   widget="statinfo"/>
                        </button>
                        <button name="action_view_retenciones" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="retenciones_count == 0">
                            <field name="retenciones_count" string="Retenciones"
                                   widget="statinfo"/>
                        </button>
                        <button name="action_view_prev_liquidation" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="not prev_liquidation_id">
                            <span class="o_stat_text">Saldo Anterior</span>
                        </button>
                    </div>
                    <group>
                        <group string="Jurisdiccion">
                            <field name="jurisdiction_id" readonly="1"/>
                            <field name="activity_id"/>
                            <field name="coefficient"/>
                            <field name="alicuota"/>
                        </group>
                        <group string="Base Imponible">
                            <field name="base_gravada"/>
                            <field name="base_no_gravada"/>
                            <field name="base_exenta"/>
                            <field name="base_distribuida"/>
                            <field name="impuesto_determinado"/>
                        </group>
                    </group>
                    <group string="Deducciones">
                        <group>
                            <field name="retenciones_sufridas"/>
                            <field name="percepciones_sufridas"/>
                        </group>
                        <group>
                            <field name="recaudaciones_bancarias"/>
                            <field name="saldo_anterior"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_deducciones"/>
                        </group>
                        <group>
                            <field name="saldo" decoration-bf="1"
                                   decoration-danger="saldo &gt; 0"
                                   decoration-success="saldo &lt;= 0"/>
                        </group>
                    </group>
                    <!-- Campos de trazabilidad ocultos (usados por smart buttons) -->
                    <field name="percepciones_move_ids" invisible="1"/>
                    <field name="retenciones_payment_ids" invisible="1"/>
                    <field name="prev_liquidation_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="liquidation_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Liquidacion - Search -->
    <record id="cm_liquidation_search" model="ir.ui.view">
        <field name="name">cm.liquidation.search</field>
        <field name="model">cm.liquidation</field>
        <field name="arch" type="xml">
            <search string="Liquidaciones CM">
                <field name="period"/>
                <field name="fiscal_year"/>
                <separator/>
                <filter name="draft" string="Borrador"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="calculated" string="Calculada"
                        domain="[('state', '=', 'calculated')]"/>
                <filter name="confirmed" string="Confirmada"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="group_period" string="Periodo"
                        context="{'group_by': 'period'}"/>
                <filter name="group_state" string="Estado"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Action con kanban como vista default (Fase 5) -->
    <record id="action_cm_liquidation" model="ir.actions.act_window">
        <field name="name">Liquidaciones CM</field>
        <field name="res_model">cm.liquidation</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
