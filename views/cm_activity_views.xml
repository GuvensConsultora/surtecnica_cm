<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cm_activity_list" model="ir.ui.view">
        <field name="name">cm.activity.list</field>
        <field name="model">cm.activity</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="jurisdiction_id"/>
                <field name="cuacm_code"/>
                <field name="name"/>
                <field name="alicuota"/>
                <field name="art_regimen"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="company_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="cm_activity_form" model="ir.ui.view">
        <field name="name">cm.activity.form</field>
        <field name="model">cm.activity</field>
        <field name="arch" type="xml">
            <form string="Actividad CUACM">
                <sheet>
                    <group>
                        <group>
                            <field name="jurisdiction_id"/>
                            <field name="cuacm_code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="alicuota"/>
                            <field name="art_regimen"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cm_activity_search" model="ir.ui.view">
        <field name="name">cm.activity.search</field>
        <field name="model">cm.activity</field>
        <field name="arch" type="xml">
            <search string="Actividades CUACM">
                <field name="cuacm_code"/>
                <field name="name"/>
                <field name="jurisdiction_id"/>
                <separator/>
                <filter name="group_jurisdiction" string="Jurisdicción"
                        context="{'group_by': 'jurisdiction_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cm_activity" model="ir.actions.act_window">
        <field name="name">Actividades CUACM</field>
        <field name="res_model">cm.activity</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
