<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Grupo de acceso para Convenio Multilateral -->
    <!-- Por qué: Separar permisos CM de contabilidad general.
         Solo usuarios con este grupo pueden gestionar liquidaciones CM. -->
    <record id="group_cm_user" model="res.groups">
        <field name="name">Convenio Multilateral / Usuario</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_cm_manager" model="res.groups">
        <field name="name">Convenio Multilateral / Responsable</field>
        <field name="implied_ids" eval="[(4, ref('surtecnica_cm.group_cm_user'))]"/>
    </record>

</odoo>
