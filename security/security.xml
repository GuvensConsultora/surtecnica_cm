<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Grupos de acceso para Convenio Multilateral -->
    <!-- Por qué: se definen grupos propios para separar permisos CM.
         Se asignan automáticamente via implied_ids en los grupos de contabilidad
         para que los menús sean visibles sin configuración manual. -->
    <record id="group_cm_user" model="res.groups">
        <field name="name">Convenio Multilateral / Usuario</field>
    </record>

    <record id="group_cm_manager" model="res.groups">
        <field name="name">Convenio Multilateral / Responsable</field>
        <field name="implied_ids" eval="[(4, ref('group_cm_user'))]"/>
    </record>

    <!-- Por qué: al heredar implied_ids en los grupos estándar de contabilidad,
         cualquier usuario contable recibe automáticamente acceso CM.
         Patrón: mismo que usa l10n_ar_withholding para sus grupos. -->
    <record id="account.group_account_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_cm_user'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_cm_manager'))]"/>
    </record>

</odoo>
